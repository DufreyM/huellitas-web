generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// ENUMS
// =======================

enum PetSpecies {
  Perro
  Gato
}

enum PetGender {
  Macho
  Hembra
}

enum PetSize {
  Pequeno
  Mediano
  Grande
}

enum PetStatus {
  Disponible
  En_tratamiento
  Reservada
  Adoptada
  No_disponible
}

enum MedicalRecordType {
  Consulta
  Desparasitacion
  Tratamiento
  Vacunacion
  Castracion
}

enum AdoptionRequestStatus {
  Pendiente
  En_revision
  Aprobada
  Rechazada
}

enum EventType {
  Jornada_adopcion
  Jornada_vacunacion
  Jornada_castracion
  Feria
  Recaudacion
  Otro
}

enum EventStatus {
  Programado
  En_curso
  Finalizado
  Cancelado
}

enum ProcedureType {
  Vacunacion
  Castracion
}

enum PaymentMethod {
  Efectivo
  Transferencia
  Deposito
  Tarjeta
  Otro
}

enum UserRole {
  Superadministrador
  Voluntario
  Operador
}

enum CastrationPatientStatus {
  Inscrito
  Evaluado
  Aprobado
  Rechazado
  Pagado
  Castrado
  En_seguimiento
  Seguimiento_finalizado
}

enum FollowUpStatus {
  Pendiente
  Finalizado
}

// =======================
// MODELS
// =======================

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String
  role         UserRole @default(Voluntario)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpires   DateTime? @map("password_reset_expires")
  lastLoginAt            DateTime? @map("last_login_at")

  events            Event[]
  petStatusChanges  PetStatusHistory[]

  @@map("users")
}

model Pet {
  id           Int        @id @default(autoincrement())
  name         String
  species      PetSpecies
  breed        String
  gender       PetGender
  estimatedAge String     @map("estimated_age")
  size         PetSize
  weight       Decimal    @db.Decimal(5, 2)
  color        String
  description  String
  rescueStory  String     @map("rescue_story")
  status       PetStatus
  featured     Boolean    @default(false)
  isActive     Boolean    @default(true) @map("is_active")
  intakeDate   DateTime   @default(now()) @map("intake_date") @db.Date
  createdAt    DateTime   @default(now()) @map("created_at")

  images           PetImage[]
  medicalRecords   MedicalRecord[]
  adoptionRequests AdoptionRequest[]
  adoptions        Adoption[]
  successStories   SuccessStory[]
  statusHistory    PetStatusHistory[]

  @@map("pets")
}

model PetImage {
  id       Int     @id @default(autoincrement())
  petId    Int     @map("pet_id")
  imageUrl String  @map("image_url")
  isCover  Boolean @default(false) @map("is_cover")

  pet Pet @relation(fields: [petId], references: [id])

  @@map("pet_images")
}

model MedicalRecord {
  id               Int               @id @default(autoincrement())
  petId            Int               @map("pet_id")
  consultationDate DateTime          @map("consultation_date") @db.Date
  recordType       MedicalRecordType @map("record_type")
  description      String
  treatment        String
  observations     String

  pet Pet @relation(fields: [petId], references: [id])

  @@map("medical_records")
}

model Adopter {
  id           Int      @id @default(autoincrement())
  fullName     String   @map("full_name")
  dpi          String   @unique
  phone        String
  email        String
  address      String
  municipality String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  adoptionRequests AdoptionRequest[]
  adoptions        Adoption[]

  @@map("adopters")
}

model AdoptionRequest {
  id              Int                   @id @default(autoincrement())
  adopterId       Int                   @map("adopter_id")
  petId           Int                   @map("pet_id")
  status          AdoptionRequestStatus
  reason          String
  hasChildren     Boolean               @map("has_children")
  familyAgreement Boolean               @map("family_agreement")
  hasVeterinarian Boolean               @map("has_veterinarian")
  secureSpace     Boolean               @map("secure_space")
  submittedAt     DateTime              @default(now()) @map("submitted_at")

  adopter Adopter @relation(fields: [adopterId], references: [id])
  pet     Pet     @relation(fields: [petId], references: [id])

  adoption Adoption?

  @@map("adoption_requests")
}

model Adoption {
  id           Int      @id @default(autoincrement())
  adopterId    Int      @map("adopter_id")
  petId        Int      @map("pet_id")
  requestId    Int      @unique @map("request_id")
  adoptionDate DateTime @map("adoption_date") @db.Date
  isReturned   Boolean  @default(false) @map("is_returned")
  returnReason String?  @map("return_reason")
  observations String?

  adopter Adopter         @relation(fields: [adopterId], references: [id])
  pet     Pet             @relation(fields: [petId], references: [id])
  request AdoptionRequest @relation(fields: [requestId], references: [id])

  @@map("adoptions")
}

model Event {
  id          Int         @id @default(autoincrement())
  title       String
  type        EventType
  description String
  location    String
  startDate   DateTime    @map("start_date")
  endDate     DateTime    @map("end_date")
  status      EventStatus
  createdBy   Int         @map("created_by")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")

  creator       User                @relation(fields: [createdBy], references: [id])
  registrations EventRegistration[]
  timeSlots     EventTimeSlot[]

  @@map("events")
}

// Tandas/horarios de una jornada (p. ej. 25 pacientes a las 9:00, 25 a las 11:00).
// El cupo total de la jornada se calcula sumando estos cupos, no se guarda aparte,
// para que nunca queden desincronizados.
model EventTimeSlot {
  id        Int    @id @default(autoincrement())
  eventId   Int    @map("event_id")
  startTime String @map("start_time")
  capacity  Int

  event         Event                @relation(fields: [eventId], references: [id])
  registrations EventRegistration[]

  @@map("event_time_slots")
}

model EventRegistration {
  id                  Int                     @id @default(autoincrement())
  eventId             Int                     @map("event_id")
  timeSlotId          Int                     @map("time_slot_id")
  petName             String                  @map("pet_name")
  species             PetSpecies
  gender              PetGender
  breed               String
  birthDate           DateTime                @map("birth_date") @db.Date
  lastDewormingDate    DateTime                @map("last_deworming_date") @db.Date
  lastVaccinationDate DateTime                @map("last_vaccination_date") @db.Date
  ownerName           String                  @map("owner_name")
  ownerPhone          String                  @map("owner_phone")
  ownerEmail          String                  @map("owner_email")
  procedureType       ProcedureType           @map("procedure_type")
  status              CastrationPatientStatus @default(Inscrito)
  surgeryDate         DateTime?               @map("surgery_date") @db.Date
  antibioticStatus    FollowUpStatus?         @map("antibiotic_status")
  stitchRemovalStatus FollowUpStatus?         @map("stitch_removal_status")
  followUpCompleted   Boolean                 @default(false) @map("follow_up_completed")
  observations        String?
  notes               String?
  createdAt           DateTime                @default(now()) @map("created_at")

  event    Event         @relation(fields: [eventId], references: [id])
  timeSlot EventTimeSlot @relation(fields: [timeSlotId], references: [id])

  @@map("event_registrations")
}

model Donation {
  id            Int           @id @default(autoincrement())
  donorName     String        @map("donor_name")
  donorEmail    String        @map("donor_email")
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  donationDate  DateTime      @default(now()) @map("donation_date")
  notes         String?

  @@map("donations")
}

model Supply {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  currentStock Decimal @map("current_stock") @db.Decimal(10, 2)
  unit         String

  donations SupplyDonation[]

  @@map("supplies")
}

model SupplyDonation {
  id           Int      @id @default(autoincrement())
  supplyId     Int      @map("supply_id")
  quantity     Decimal  @db.Decimal(10, 2)
  donorName    String   @map("donor_name")
  donationDate DateTime @default(now()) @map("donation_date")
  notes        String?

  supply Supply @relation(fields: [supplyId], references: [id])

  @@map("supply_donations")
}

model SuccessStory {
  id              Int      @id @default(autoincrement())
  petId           Int      @map("pet_id")
  title           String
  content         String
  imageUrl        String   @map("image_url")
  publicationDate DateTime @map("publication_date") @db.Date

  pet Pet @relation(fields: [petId], references: [id])

  @@map("success_stories")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contacts")
}

model SiteSetting {
  id                     Int      @id @default(1)
  instagramHandle        String   @default("@huellitasdelacalleong") @map("instagram_handle")
  contactEmail           String   @default("contacto@huellitas.org") @map("contact_email")
  whatsappNumber         String   @default("50212345678") @map("whatsapp_number")
  bankName               String   @default("Banco Industrial") @map("bank_name")
  bankAccountType        String   @default("Cuenta Monetaria") @map("bank_account_type")
  bankAccountNumber      String   @default("123-456789-0") @map("bank_account_number")
  bankAccountHolder      String   @default("Asociación Huellitas de la Calle") @map("bank_account_holder")
  donationDropoffAddress String   @default("Zona 10, Ciudad de Guatemala") @map("donation_dropoff_address")
  donationDropoffHours   String   @default("Lunes a sábado de 9:00 AM a 4:00 PM") @map("donation_dropoff_hours")
  neededSupplies         String[] @default(["Concentrado para perros", "Concentrado para gatos", "Medicamentos", "Camas y Cobijas", "Correas", "Transportadoras", "Arena para gatos", "Productos de limpieza"]) @map("needed_supplies")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model PetStatusHistory {
  id             Int        @id @default(autoincrement())
  petId          Int        @map("pet_id")
  previousStatus PetStatus? @map("previous_status")
  newStatus      PetStatus  @map("new_status")
  note           String?
  changedByUserId Int       @map("changed_by_user_id")
  changedAt      DateTime   @default(now()) @map("changed_at")

  pet       Pet  @relation(fields: [petId], references: [id])
  changedBy User @relation(fields: [changedByUserId], references: [id])

  @@map("pet_status_history")
}
